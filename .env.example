# Copy this file to `.env.local` and set your own value.
#
# Passphrase for the hidden content console. It is inlined into the browser
# bundle at build time (NEXT_PUBLIC_), so it is a casual gate, not real
# security. No value = the console cannot be unlocked.
#
# Leave the value blank in this file — set it locally in .env.local and, for
# GitHub Pages, as a repository secret named NEXT_PUBLIC_ADMIN_PASSPHRASE.

NEXT_PUBLIC_ADMIN_PASSPHRASE=
